#!/usr/bin/env bash
# msw-notes — read and write the user's notes file.
#
#   msw-notes path                    print the notes file location
#   msw-notes read                    print the content; missing file -> exits 0
#                                      with no output. A file that EXISTS but
#                                      cannot be read (permissions, or a
#                                      directory sitting at the notes path) is
#                                      NOT the same as missing -> message on
#                                      stderr, exit 1, nothing on stdout. On
#                                      either exit-0 outcome (content or
#                                      missing) also prints "MTIME:<epoch>" to
#                                      stderr -- the mtime read in THIS SAME
#                                      invocation, immediately before the
#                                      content -- so a caller never needs a
#                                      second, separate `mtime` call that could
#                                      itself race an external writer.
#   msw-notes mtime                   modification time in epoch seconds (missing -> 0)
#   msw-notes write --base64 <data>   write atomically, mode 600; prints the
#                                      new mtime (epoch seconds) on success
#
# The notes are user data, not machine state, which is why they are NOT part
# of msw-status: notes about a server tend to contain credentials, and the
# status JSON is handed around freely. A plain file also means the notes stay
# reachable over SSH with any editor when there is no desktop session.
#
# write takes base64 for the same reason msw-config-write does: the plasmoid
# hands its command line to /bin/sh, and base64's alphabet cannot break out of
# it regardless of quotes, newlines or metacharacters in the text.
set -uo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)
# shellcheck source=./msw-config
. "$SCRIPT_DIR/msw-config"

# Tests override MSW_NOTES_FILE to avoid touching the real notes.
NOTES_FILE="${MSW_NOTES_FILE:-$(_msw_config_home)/.config/mobileserverswitch/notes.md}"

usage() { sed -n '3,20p' "$0" | sed 's/^# \?//'; }

case "${1:-}" in
    path)
        [ $# -eq 1 ] || { echo "path takes no argument" >&2; exit 2; }
        printf '%s\n' "$NOTES_FILE"
        ;;
    read)
        [ $# -eq 1 ] || { echo "read takes no argument" >&2; exit 2; }
        if [ ! -e "$NOTES_FILE" ]; then
            # Genuinely absent: this is the only case that is allowed to look
            # like an empty file. Still report a mtime (0, matching `mtime`'s
            # own missing-file value) so a caller building loadedMtime from
            # this single invocation has one to adopt.
            echo "MTIME:0" >&2
            exit 0
        fi
        if [ -d "$NOTES_FILE" ]; then
            # A directory at the notes path is unreadable-as-notes for the
            # same reason a permission-denied file is: `cat` would fail, and
            # silently treating that as "empty" would let a save overwrite
            # whatever is really there (nothing, in this case, but the
            # failure mode is identical to the permissions case below, so it
            # gets the same treatment).
            echo "read: $NOTES_FILE is a directory, not a file" >&2
            exit 1
        fi
        if [ ! -r "$NOTES_FILE" ]; then
            # Present but unreadable (e.g. mode 000 after a `sudo $EDITOR`
            # over SSH) MUST NOT look like "missing" -- that was exactly the
            # bug: an unreadable file read as "" with exit 0, the widget
            # showed an empty pad, the user typed into it, and the next
            # autosave's freshness check (which only ever compares mtimes)
            # saw no conflict and overwrote real content with the new text.
            # `mv -f` in `write` only needs directory write permission, not
            # file read permission, so nothing below this line would have
            # stopped it.
            echo "read: $NOTES_FILE exists but is not readable" >&2
            exit 1
        fi
        # Mtime BEFORE content, in that order, deliberately: if an external
        # writer lands between these two lines, this call then reports an
        # mtime that is OLDER than the content it goes on to print. A caller
        # comparing that (stale) mtime against a later, fresh mtime check
        # will see a mismatch and refuse to save (a spurious conflict banner)
        # -- safe. The reverse order (content, then mtime) would instead
        # report a mtime that matches the external write while holding the
        # content from before it, so a subsequent autosave would see no
        # conflict and silently overwrite the external edit -- the same
        # failure this whole guard exists to prevent.
        mtime=$(stat -c '%Y' "$NOTES_FILE") || {
            echo "read: cannot stat $NOTES_FILE" >&2; exit 1; }
        if ! cat "$NOTES_FILE"; then
            echo "read: cannot read $NOTES_FILE" >&2
            exit 1
        fi
        echo "MTIME:$mtime" >&2
        exit 0
        ;;
    mtime)
        [ $# -eq 1 ] || { echo "mtime takes no argument" >&2; exit 2; }
        if [ -e "$NOTES_FILE" ]; then stat -c '%Y' "$NOTES_FILE"; else echo 0; fi
        ;;
    write)
        [ $# -eq 3 ] && [ "$2" = "--base64" ] || {
            echo "Usage: msw-notes write --base64 <data>" >&2; exit 2; }
        # Validate first, before touching anything on disk. This intentionally
        # does NOT capture the decoded bytes into a shell variable: $(...)
        # command substitution strips all trailing newlines (and can't hold
        # embedded NULs at all), which would silently truncate notes ending in
        # a blank line. The real decode below streams straight into the temp
        # file instead of round-tripping through a variable.
        printf '%s' "$3" | base64 -d >/dev/null 2>&1 || {
            echo "write: argument is not valid base64" >&2; exit 2; }
        dir=$(dirname "$NOTES_FILE")
        mkdir -p "$dir" || { echo "write: cannot create $dir" >&2; exit 1; }
        umask 077
        tmp=$(mktemp "$dir/.notes.md.XXXXXX") || { echo "write: mktemp failed" >&2; exit 1; }
        trap 'rm -f "$tmp"' EXIT
        printf '%s' "$3" | base64 -d > "$tmp" 2>/dev/null || {
            echo "write: decode failed" >&2; exit 1; }
        chmod 600 "$tmp"
        mv -f "$tmp" "$NOTES_FILE" || { echo "write: mv failed" >&2; exit 1; }
        trap - EXIT
        # Print the mtime of the file we just wrote, read in THIS SAME
        # invocation right after the rename -- not via a second, separate
        # `msw-notes mtime` call. A second call would leave a window (an
        # async round trip through the caller's process/event-loop, easily
        # milliseconds or more) in which an external writer could land and
        # get silently adopted as "the mtime of our own write". Reading it
        # here still cannot close the window to absolute zero (something
        # could in principle land between the mv and this stat), but shrinks
        # it from "one external round trip" to one stat(2) call.
        stat -c '%Y' "$NOTES_FILE"
        ;;
    "")
        usage >&2
        exit 2
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        echo "Unknown: $1" >&2; exit 2 ;;
esac
