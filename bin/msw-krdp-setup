#!/usr/bin/env bash
# msw-krdp-setup <RDP-PASSWORD>
#
# Generates the LIVE systemd user override for the KRDP server from the
# template (system/systemd-user/.../override.conf.template), inserts the
# password and writes it to ~/.config with mode 600. Reproducible, keeps the
# password out of the git repo (see template comment).
#
# Afterwards: `systemctl --user daemon-reload` (done by this script) and
#         `systemctl --user enable --now app-org.kde.krdpserver.service`
#         (deliberately NOT here -- starting the service is a live action
#          the user must trigger explicitly).
set -euo pipefail

UNIT="app-org.kde.krdpserver.service"
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TEMPLATE="$REPO_ROOT/system/systemd-user/$UNIT.d/override.conf.template"
DEST_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$UNIT.d"
DEST="$DEST_DIR/override.conf"
# shellcheck source=./msw-config
. "$REPO_ROOT/bin/msw-config"

if [ $# -ne 1 ] || [ -z "${1:-}" ]; then
    echo "Usage: $(basename "$0") <RDP-PASSWORD>" >&2
    exit 2
fi
PW=$1

if [ ! -f "$TEMPLATE" ]; then
    echo "Template not found: $TEMPLATE" >&2
    exit 1
fi
if ! command -v krdpserver >/dev/null 2>&1; then
    echo "krdpserver not installed (dnf install krdp)." >&2
    exit 1
fi

# Fail closed: RDP must bind exclusively to the Tailnet. If no Tailnet IPv4
# address can be detected (tailscale absent/down/not logged in), refuse to
# write a live override at all rather than falling back to a wider bind.
TAILNET_IP=$(detect_tailnet_ip4)
if [ -z "$TAILNET_IP" ]; then
    echo "No Tailscale IPv4 address detected -- refusing to set up RDP" >&2
    echo "(RDP must bind to the Tailnet only; see docs/KRDP.md). Ensure" >&2
    echo "tailscale is installed, running and logged in, then retry." >&2
    exit 1
fi

mkdir -p "$DEST_DIR"
# Pattern-engine-free literal substitution. Neither the needle nor the value is
# interpreted, so passwords containing & \ / or other metacharacters survive
# verbatim. This deliberately avoids both awk/sed gsub AND bash's ${x//p/r}:
# awk/sed replacements treat & as "the whole match", and bash 5.2+ does the same
# for & in the replacement of ${x//p/r} -- either would corrupt a password
# containing &. Here we split the line on the (quoted, literal) needle and
# concatenate the value directly, so no engine ever sees it. The value stays in
# shell memory and is never passed to an external process's argument list.
subst_literal() {  # subst_literal <string> <needle> <value> -> prints result
    local str=$1 needle=$2 value=$3 out=""
    while [[ $str == *"$needle"* ]]; do
        out+="${str%%"$needle"*}$value"
        str=${str#*"$needle"}
    done
    printf '%s' "$out$str"
}
umask 077
{
    while IFS= read -r line || [ -n "$line" ]; do
        line=$(subst_literal "$line" '__RDP_PASSWORD__' "$PW")
        line=$(subst_literal "$line" '__TAILNET_IP__' "$TAILNET_IP")
        printf '%s\n' "$line"
    done
} < "$TEMPLATE" > "$DEST"
chmod 600 "$DEST"

echo "Written: $DEST (mode $(stat -c '%a' "$DEST"))"
systemctl --user daemon-reload
echo "daemon-reload ok. Start/persist:"
echo "  systemctl --user enable --now $UNIT"
echo "Then verify the bind (must be the Tailnet address, not 0.0.0.0):"
echo "  ss -tlnH 'sport = :3389'"
