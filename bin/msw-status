#!/usr/bin/env bash
# msw-status --json : aggregated Mobile AI Server Switch state as JSON (read-only).
# Single-source-of-truth interface between the CLIs and the plasmoid.
set -uo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)
. "$SCRIPT_DIR/msw-config"

TAILNET_PREFIX="100."          # Tailscale CGNAT range 100.64.0.0/10
TAILNET_PREFIX6="fd7a:115c:a1e0:"   # Tailscale ULA range fd7a:115c:a1e0::/48
PSTATE=/sys/devices/system/cpu/intel_pstate
GPU_DEV=/sys/bus/pci/devices/0000:01:00.0
WOL_NIC=$(cfg_or_detect network.wol_nic detect_wol_nic)

# --- Derive exposure of a TCP port from actually listening sockets -----------
exposure_for_port() {  # $1 = port ; echo "localhost" | "Tailnet" | "LAN" | "LAN+Tailnet" | ""
    local port=$1 addrs local=0 tail=0 lan=0
    addrs=$(ss -tlnH "sport = :$port" 2>/dev/null | awk '{print $4}')
    [ -z "$addrs" ] && { echo ""; return; }
    local a ip
    while read -r a; do
        [ -z "$a" ] && continue
        ip=${a%:*}; ip=${ip#\[}; ip=${ip%\]}
        ip=${ip%\%*}          # strip an IPv6 zone index (fe80::1%eth0)
        ip=${ip,,}            # ss prints hex lowercase, but do not rely on it
        case "$ip" in
            127.0.0.1|::1)         local=1 ;;
            0.0.0.0|::|\*)         lan=1; tail=1 ;;
            ${TAILNET_PREFIX}*)    tail=1 ;;
            ${TAILNET_PREFIX6}*)   tail=1 ;;
            *)                     lan=1 ;;
        esac
    done <<< "$addrs"
    local out=()
    [ "$local" = 1 ] && out+=("localhost")
    [ "$lan" = 1 ]   && out+=("LAN")
    [ "$tail" = 1 ] && [ "$lan" = 0 ] && out+=("Tailnet")
    ( IFS=+; echo "${out[*]}" )
}

port_active() { ss -tlnH "sport = :$1" 2>/dev/null | grep -q . && echo true || echo false; }

svc_active_user()   { systemctl --user is-active "$1" 2>/dev/null | grep -qx active && echo true || echo false; }
svc_active_system() { systemctl is-active "$1" 2>/dev/null | grep -qx active && echo true || echo false; }

# --- Wake-on-LAN (best effort: sudo/ethtool may fail without breaking the JSON) --
wol_json() {  # $1 = nic
    local nic=$1 out supported=null enabled=null mode="?"
    out=$(sudo -n ethtool "$nic" 2>/dev/null)
    if [ -n "$out" ]; then
        # A missing line means UNKNOWN, not false: ethtool output can be partial
        # (truncated, unusual driver), and claiming "not supported" / "off" for
        # something we could not read would be a lie the widget then displays.
        echo "$out" | grep -q "Supports Wake-on:" && supported=true
        mode=$(echo "$out" | awk -F': ' '/^[[:space:]]*Wake-on:/{print $2}' | tr -d '[:space:]')
        if [ -n "$mode" ]; then
            [ "$mode" != "d" ] && enabled=true || enabled=false
        else
            mode="?"      # enabled stays null = unknown
        fi
    fi
    jq -n --argjson supported "$supported" --argjson enabled "$enabled" --arg mode "$mode" \
          '{supported:$supported,enabled:$enabled,mode:$mode}'
}

# --- Mode (from state file) ---------------------------------------------------
MODE=$( [ -r /var/lib/mobileserverswitch/mode ] && cat /var/lib/mobileserverswitch/mode || echo "?" )

# --- Performance ---------------------------------------------------------------
PROFILE=$(busctl --system get-property org.freedesktop.UPower.PowerProfiles \
    /org/freedesktop/UPower/PowerProfiles \
    org.freedesktop.UPower.PowerProfiles ActiveProfile 2>/dev/null | sed 's/^s "//;s/"$//')
[ -z "$PROFILE" ] && PROFILE="?"
MPP=$(cat "$PSTATE/max_perf_pct" 2>/dev/null || echo 100)
NOTURBO=$(cat "$PSTATE/no_turbo" 2>/dev/null || echo 0)
TURBO=$([ "$NOTURBO" = "0" ] && echo true || echo false)

# --- Power / battery -----------------------------------------------------------
# Generic detection (not hardcoded to BAT0, matching msw-mode/msw-charge-apply):
# first /sys/class/power_supply/*/ whose `type` reads "Battery" and exposes a
# `capacity` file, else the first BAT* directory. Empty if no battery exists
# (e.g. a desktop) -- BATT stays null, everything else below degrades to "?".
BAT=""
for _d in /sys/class/power_supply/*/; do
    [ -e "${_d}capacity" ] || continue
    if [ "$(cat "${_d}type" 2>/dev/null)" = "Battery" ]; then
        BAT=${_d%/}
        break
    fi
done
if [ -z "$BAT" ]; then
    for _d in /sys/class/power_supply/BAT*/; do
        [ -e "$_d" ] || continue
        BAT=${_d%/}
        break
    done
fi
unset _d
BATT=$(cat "$BAT/capacity" 2>/dev/null || echo null)
CS=$(cat "$BAT/charge_control_start_threshold" 2>/dev/null || echo "?")
CE=$(cat "$BAT/charge_control_end_threshold" 2>/dev/null || echo "?")
BSTATUS=$(cat "$BAT/status" 2>/dev/null || echo "?")
AC=$([ "$BSTATUS" = "Discharging" ] && echo false || echo true)

# --- Tailscale -------------------------------------------------------------
# network.tailscale is a presence/enable *toggle*, not the tailnet IP (design
# spec §2a/§2b): "auto" (or absent) -> detect presence via has_tailscale();
# "off"/"disabled"/"false"/"no" -> treat Tailscale as absent (feature off).
# The tailnet IPv4 itself is always auto-detected -- there is no IP override.
TS_HOST=$(hostname 2>/dev/null)
TS_MODE=$(msw_cfg network.tailscale auto)
case "$TS_MODE" in
    off|disabled|false|no) TS_PRESENT=false ;;
    *) if has_tailscale; then TS_PRESENT=true; else TS_PRESENT=false; fi ;;
esac
if [ "$TS_PRESENT" = true ]; then
    TS_IP4=$(detect_tailnet_ip4); [ -z "$TS_IP4" ] && TS_IP4="?"
    TS_ACTIVE=$([ "$TS_IP4" != "?" ] && echo true || echo false)
    TS_PEERS=$(tailscale status --json 2>/dev/null | jq '(.Peer // {}) | length' 2>/dev/null)
    if ! [[ "$TS_PEERS" =~ ^[0-9]+$ ]]; then TS_PEERS=0; fi
else
    TS_IP4="?"
    TS_ACTIVE=false
    TS_PEERS=0
fi

# --- GPU (dGPU on PCI 0000:01:00.0, runtime PM) -------------------------------
GPU_PRESENT=$([ -e "$GPU_DEV" ] && echo true || echo false)
GPU_RUNTIME=$(cat "$GPU_DEV/power/runtime_status" 2>/dev/null || echo "?")
GPU_AWAKE=$([ "$GPU_RUNTIME" = "active" ] && echo true || echo false)
GPU_DSTATE=$(cat "$GPU_DEV/power_state" 2>/dev/null || echo "?")
GPU_WATTS=null
if [ "$GPU_AWAKE" = true ]; then
    w=$(nvidia-smi --query-gpu=power.draw --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d '[:space:]')
    [[ "$w" =~ ^[0-9]+([.][0-9]+)?$ ]] && GPU_WATTS="$w"
fi
GPU_CONTROL=$(cat "$GPU_DEV/power/control" 2>/dev/null || echo "?")
[ -z "$GPU_CONTROL" ] && GPU_CONTROL="?"

# --- Power extras (EPP / ASPM / radios) ---------------------------------------
EPP=$(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference 2>/dev/null || echo "?")
[ -z "$EPP" ] && EPP="?"
ASPM=$(cat /sys/module/pcie_aspm/parameters/policy 2>/dev/null | grep -oP '\[\K[^]]+')
[ -z "$ASPM" ] && ASPM="?"
WIFI=$(rfkill list wifi 2>/dev/null | grep -q "Soft blocked: yes" && echo off || echo on)
BT=$(rfkill list bluetooth 2>/dev/null | grep -q "Soft blocked: yes" && echo off || echo on)

# --- Wake-on-LAN -----------------------------------------------------------
WOL=$(wol_json "$WOL_NIC")

# --- Network: interfaces, default route, DNS ----------------------------------
# `ip -j` emits real JSON (iproute2 >= 5), so this is a jq transform rather
# than line parsing. Every branch degrades to empty/null instead of failing:
# a missing `ip` must not break the status output.
NET_HOST=$(hostname 2>/dev/null); [ -z "$NET_HOST" ] && NET_HOST="?"

NET_ADDR_RAW=$(ip -j addr 2>/dev/null)
[ -z "$NET_ADDR_RAW" ] && NET_ADDR_RAW="[]"
NET_ROUTE_RAW=$(ip -j route show default 2>/dev/null)
[ -z "$NET_ROUTE_RAW" ] && NET_ROUTE_RAW="[]"

# The default route: LOWEST metric wins. This machine has two (ethernet at
# metric 100, wifi at 600) -- taking the first entry would be a coin flip.
NET_DEFAULT=$(jq -c '
    map(select(.dst == "default"))
    | sort_by(.metric // 0)
    | if length == 0 then null
      else { iface: .[0].dev, gateway: (.[0].gateway // null), ip4: (.[0].prefsrc // null) }
      end' <<<"$NET_ROUTE_RAW" 2>/dev/null)
[ -z "$NET_DEFAULT" ] && NET_DEFAULT=null

NET_DEFAULT_IFACE=$(jq -r 'if . == null then "" else (.iface // "") end' <<<"$NET_DEFAULT" 2>/dev/null)

# Virtual-interface pattern uses `br[0-9-]`, not a literal `br-`: a hand-made
# bridge on a VM host (a setup this project targets) is conventionally named
# "br0", "br1", ... with no hyphen -- a literal `br-` only matched Docker's
# "br-<hash>" form and let a plain bridge fall through to "ether", presenting
# a virtual bridge as a physical link. The third-character class still
# excludes unrelated names that merely start with "br" (e.g. a hypothetical
# "bridge0" or "brcm0"), since neither has a digit or hyphen as the third
# character.
NET_IFACES=$(jq -c --arg def "$NET_DEFAULT_IFACE" '
    map(select(.ifname != "lo"))
    | map({
        name: .ifname,
        kind: (
          if   (.ifname | startswith("tailscale")) then "tailnet"
          elif (.ifname | test("^(virbr|docker|podman|cni-|veth|br[0-9-])")) then "virtual"
          elif (.ifname | test("^wl")) then "wifi"
          elif (.link_type == "ether") then "ether"
          else "other" end),
        # operstate alone misclassifies tun-type devices (tailscale0 reports
        # "UNKNOWN", never "UP", despite being fully functional) and the
        # admin-only IFF_UP flag alone would misclassify a carrier-less bridge
        # as up (virbr0 has IFF_UP set with no VM running and no carrier). A
        # link counts as up when the kernel reports it operationally up OR
        # when it has carrier (LOWER_UP) -- the latter is what actually
        # matters for "can I use this interface right now".
        up: (.operstate == "UP" or ((.flags // []) | index("LOWER_UP") != null)),
        mac: (.address // null),
        ip4: [ (.addr_info // [])[] | select(.family == "inet" and (.scope // "") != "host")
               | "\(.local)/\(.prefixlen)" ],
        ip6: [ (.addr_info // [])[] | select(.family == "inet6" and (.scope // "") == "global")
               | "\(.local)/\(.prefixlen)" ],
        is_default: (.ifname == $def)
      })' <<<"$NET_ADDR_RAW" 2>/dev/null)
[ -z "$NET_IFACES" ] && NET_IFACES="[]"

# DNS: resolvectl is per-link and line based; empty links are dropped and
# addresses deduplicated. Falls back to resolv.conf, then to an empty list.
net_dns() {
    local out=""
    if command -v resolvectl >/dev/null 2>&1; then
        out=$(resolvectl dns 2>/dev/null | sed 's/^[^:]*: *//' | tr ' ' '\n')
    fi
    if [ -z "$(tr -d '[:space:]' <<<"${out:-}")" ] && [ -r /etc/resolv.conf ]; then
        out=$(awk '/^nameserver/ {print $2}' /etc/resolv.conf)
    fi
    printf '%s\n' "$out" | awk 'NF && !seen[$0]++'
}
# `-n` is required: without it, plain `jq -R` auto-consumes the first input
# line as the implicit `.` for the filter's first invocation, and `[inputs]`
# only sees the *remaining* lines -- silently dropping the first resolver (or
# the only one, yielding `[]` even though a resolver is configured).
NET_DNS=$(net_dns | jq -Rcn '[inputs] // []' 2>/dev/null)
[ -z "$NET_DNS" ] && NET_DNS="[]"

NETWORK=$(jq -nc --arg hostname "$NET_HOST" --argjson default "$NET_DEFAULT" \
                 --argjson dns "$NET_DNS" --argjson interfaces "$NET_IFACES" \
  '{hostname:$hostname,default:$default,dns:$dns,interfaces:$interfaces}')

# --- Firewall (firewalld, read-only) ------------------------------------------
# Security note: nothing is written/changed here, only `--list-*` (unprivileged
# readable) is evaluated. Every error branch (firewalld inactive, firewall-cmd
# missing) still returns valid JSON with sensible defaults, exit stays 0 (same
# pattern as gpu/power_extra/remote).
FW_ZONE=$(cfg_or_detect network.firewall_zone detect_firewall_zone)
FW_ACTIVE=false
FW_ALL=""
if command -v firewall-cmd >/dev/null 2>&1; then
    # ONE call instead of six in the common case. Each firewall-cmd
    # invocation costs ~0.3 s (D-Bus round trip plus Python startup), and
    # asking six times made msw-status take ~2 s. `--list-all` returns
    # interfaces, services, ports and rich rules in a single block, which
    # is everything read below.
    FW_ALL=$(firewall-cmd --list-all --zone="$FW_ZONE" 2>/dev/null)
    if [ -n "$FW_ALL" ]; then
        FW_ACTIVE=true
    else
        # --list-all fails both when firewalld is not running AND when
        # network.firewall_zone (user-editable config) names a zone that
        # does not exist -- those are different states, and only the first
        # one means firewalld is actually down. One extra --state call
        # disambiguates; it only runs on this already-failed path, so the
        # happy path stays a single call.
        [ "$(firewall-cmd --state 2>/dev/null)" = "running" ] && FW_ACTIVE=true
    fi
fi

# fw_field <name> -- value of one "  <name>: <value>" line from --list-all.
# Rich rules are multi-line and handled separately below. When FW_ALL is
# empty (firewalld active but the configured zone is invalid), every field
# below is correctly empty too.
fw_field() {
    printf '%s\n' "$FW_ALL" | awk -v k="$1" '
        $0 ~ "^[[:space:]]+" k ":" { sub("^[[:space:]]+" k ":[[:space:]]*", ""); print; exit }'
}

if [ "$FW_ACTIVE" = true ]; then
    FW_ZONE_J=$(jq -nc --arg z "$FW_ZONE" '$z')
    FW_PORTS=$(fw_field "ports")
    FW_SERVICES=$(fw_field "services")
    FW_IFACES_RAW=$(fw_field "interfaces")
    # "rich rules:" opens a block whose entries follow on their own lines
    # until the end of the output.
    FW_RICH=$(printf '%s\n' "$FW_ALL" | sed -n '/^[[:space:]]*rich rules:/,$p' | tail -n +2)
    FW_HIGH=$(grep -q '1025-65535/tcp' <<<"$FW_PORTS" && echo true || echo false)
    FW_SSH=$(grep -qw ssh <<<"$FW_SERVICES" && echo true || echo false)
else
    FW_ZONE_J=null
    FW_RICH=""
    FW_IFACES_RAW=""
    FW_HIGH=false
    FW_SSH=false
fi

# App list + blocked-state (config-driven; see design spec §2a/§3 and
# msw-firewall-apply, which is the single source of truth for the actual
# rule/marker shape). Default (config absent/empty firewall.apps) = rdp+vnc
# only -- nothing is hardcoded to sunshine/comfyui/etc here anymore.
fw_app_ids() {
    if command -v jq >/dev/null 2>&1 && [ -r "$MSW_CONFIG_FILE" ]; then
        local ids
        ids=$(jq -r '.firewall.apps // [] | .[].id // empty' "$MSW_CONFIG_FILE" 2>/dev/null \
              | grep -vixE 'ssh|22|tailscale|tailscale0')
        if [ -n "$ids" ]; then printf '%s\n' "$ids"; return; fi
    fi
    printf 'rdp\nvnc\n'
}

# fw_app_ports <id> — prints "ports_tcp ports_udp" for the given app id,
# reading config.firewall.apps if present, else the built-in default
# (rdp=3389/tcp, vnc=5900-5903/tcp).
fw_app_ports() {
    local id=$1 entry ptcp="" pudp="" found=0
    if command -v jq >/dev/null 2>&1 && [ -r "$MSW_CONFIG_FILE" ]; then
        entry=$(jq -c --arg id "$id" '(.firewall.apps // [])[] | select(.id == $id)' "$MSW_CONFIG_FILE" 2>/dev/null | head -1)
        if [ -n "$entry" ]; then
            found=1
            ptcp=$(jq -r '.ports_tcp // empty' <<<"$entry" 2>/dev/null)
            pudp=$(jq -r '.ports_udp // empty' <<<"$entry" 2>/dev/null)
        fi
    fi
    if [ "$found" = 0 ]; then
        case "$id" in
            rdp) ptcp="3389" ;;
            vnc) pudp="" ptcp="5900-5903" ;;
        esac
    fi
    printf '%s %s' "$ptcp" "$pudp"
}

# fw_app_label <id> — human display label for an app id: known ids get a
# proper acronym/name, anything else is Title-Cased with -/_ treated as word
# separators (e.g. "my-app" -> "My App"). Purely id-derived -- config has no
# separate "label" field for firewall.apps (see design spec §2a).
fw_app_label() {
    local id=$1
    case "$id" in
        rdp) echo "RDP" ;;
        vnc) echo "VNC" ;;
        *) echo "$id" | tr '_-' '  ' \
               | awk '{for (i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) substr($i,2); print}' ;;
    esac
}

# fw_ports_human <ports_tcp> <ports_udp> — human-readable "<ports>/tcp[, <ports>/udp]"
# string for display, e.g. "3389/tcp" or "5900-5903/tcp".
fw_ports_human() {
    local ptcp=$1 pudp=$2 parts=()
    [ -n "$ptcp" ] && parts+=("${ptcp}/tcp")
    [ -n "$pudp" ] && parts+=("${pudp}/udp")
    local IFS=,; echo "${parts[*]}"
}

FW_APPS="{}"
while IFS= read -r fw_id; do
    [ -z "$fw_id" ] && continue
    read -r fw_ptcp fw_pudp <<< "$(fw_app_ports "$fw_id")"
    fw_blocked=false
    for fw_tok in ${fw_ptcp//,/ } ${fw_pudp//,/ }; do
        [ -z "$fw_tok" ] && continue
        grep -qF "port=\"$fw_tok\"" <<<"$FW_RICH" && fw_blocked=true
    done
    fw_label=$(fw_app_label "$fw_id")
    fw_ports=$(fw_ports_human "$fw_ptcp" "$fw_pudp")
    FW_APPS=$(jq --arg id "$fw_id" --argjson blocked "$fw_blocked" \
                 --arg label "$fw_label" --arg ports "$fw_ports" \
                 '. + {($id): {blocked: $blocked, label: $label, ports: $ports}}' <<<"$FW_APPS")
done < <(fw_app_ids)

if [ -n "$FW_IFACES_RAW" ]; then
    FW_LAN_IFACES_JSON=$(jq -nc --arg s "$FW_IFACES_RAW" '$s | split(" ") | map(select(length>0))')
else
    # firewalld inactive/absent or zone has no interfaces bound: fall back to
    # detected (or config-overridden) default-route interfaces.
    FW_LAN_IFACES_JSON=$(jq -nc --arg s "$(cfg_or_detect network.lan_interfaces detect_lan_ifaces)" \
        '$s | split(" ") | map(select(length>0))')
fi

FIREWALL=$(jq -n \
  --argjson zone "$FW_ZONE_J" --argjson lan_ifaces "$FW_LAN_IFACES_JSON" \
  --argjson high_ports_open "$FW_HIGH" --argjson ssh_allowed "$FW_SSH" \
  --argjson apps "$FW_APPS" \
  '{zone:$zone,lan_ifaces:$lan_ifaces,high_ports_open:$high_ports_open,ssh_allowed:$ssh_allowed,apps:$apps}')

# --- RDP (KRDP) / VNC: installed + active status -------------------------------
RDP_INST=$(command -v krdpserver >/dev/null 2>&1 && echo true || (rpm -q krdp >/dev/null 2>&1 && echo true || echo false))
RDP_ACTIVE=$(svc_active_user app-org.kde.krdpserver.service)
[ "$RDP_ACTIVE" = false ] && RDP_ACTIVE=$(port_active 3389)
VNC_INST=$( (command -v krfb >/dev/null 2>&1 || command -v wayvnc >/dev/null 2>&1) && echo true || echo false)

# Who holds 5900-5903? `ss -tlnp` names the process for sockets owned by the
# invoking user and stays silent for anyone else's -- that asymmetry is the
# whole trick, and it needs no privileges. A listener without a name is
# therefore a foreign one, in practice a VM console: libvirt's SPICE with
# autoport starts at 5900 too, so this range is not ours alone.
VNC_LINES=$(ss -tlnpH 'sport >= :5900 and sport <= :5903' 2>/dev/null)
if [ -n "$VNC_LINES" ]; then
    VNC_ACTIVE=true
    VNC_PORT=$(awk '{ n=split($4,a,":"); print a[n] }' <<<"$VNC_LINES" | sort -n | head -1)
    [[ "$VNC_PORT" =~ ^[0-9]+$ ]] || VNC_PORT=null
    VNC_OWNER=$(grep -o 'users:((\"[^\"]*\"' <<<"$VNC_LINES" | head -1 | sed 's/.*((\"//;s/\"$//')
else
    VNC_ACTIVE=false
    VNC_PORT=null
    VNC_OWNER=""
fi
if [ -n "$VNC_OWNER" ]; then
    VNC_OWNER_J=$(jq -nc --arg o "$VNC_OWNER" '$o')
else
    VNC_OWNER_J=null
fi

# --- Sunshine: installed status (mirrors RDP_INST/VNC_INST above) --------------
# Sunshine ships either as a native package (binary on PATH) or as a flatpak
# (no binary on PATH, but its systemd --user unit file is always installed by
# either packaging, since the unit ships the same "app-dev.lizardbyte.app.
# Sunshine.service" name regardless of install method -- verified on a native
# install: `systemctl --user list-unit-files` lists it even though `sunshine`
# is also on PATH there). Checking the unit-file listing (not just `command -v
# sunshine`) means a flatpak-only install is still detected as installed, even
# though `sunshine` never appears on PATH in that case.
SUN_INST=$(command -v sunshine >/dev/null 2>&1 && echo true \
    || (systemctl --user list-unit-files 2>/dev/null \
        | grep -q '^app-dev\.lizardbyte\.app\.Sunshine\.service' && echo true || echo false))

# --- Services array (config-driven) --------------------------------------------
# Built entirely from config.services (~/.config/mobileserverswitch/config.json);
# no service is hardcoded here. Missing config / missing `services` key / empty
# array -> services: []. Each config entry: {id,label,unit,scope,port}; `scope`
# selects systemctl --user vs system-wide `is-active`. `unit` is echoed back so
# the plasmoid never has to guess/hardcode it (see ServicesTab.qml).
svc_row() {  # $1 id  $2 label  $3 unit  $4 scope(user|system)  $5 port
    local active
    [ "$4" = system ] && active=$(svc_active_system "$3") || active=$(svc_active_user "$3")
    jq -n --arg id "$1" --arg label "$2" --arg unit "$3" --arg scope "$4" \
          --argjson active "$active" --argjson port "${5:-0}" \
          --arg exposure "$(exposure_for_port "${5:-0}")" \
          '{id:$id,label:$label,unit:$unit,scope:$scope,active:$active,port:$port,exposure:$exposure}'
}
SERVICES_ROWS=""
if command -v jq >/dev/null 2>&1 && [ -r "$MSW_CONFIG_FILE" ]; then
    CONFIG_SERVICES=$(jq -c '.services // [] | .[]' "$MSW_CONFIG_FILE" 2>/dev/null)
    if [ -n "$CONFIG_SERVICES" ]; then
        while IFS= read -r svc; do
            [ -z "$svc" ] && continue
            id=$(jq -r '.id // empty' <<<"$svc")
            label=$(jq -r '.label // .id // "?"' <<<"$svc")
            unit=$(jq -r '.unit // empty' <<<"$svc")
            scope=$(jq -r '.scope // "user"' <<<"$svc")
            port=$(jq -r '.port // 0' <<<"$svc")
            [ -z "$unit" ] && continue   # malformed entry (no unit) -> skip
            [ -z "$id" ] && continue     # malformed entry (no id) -> skip
            SERVICES_ROWS+=$(svc_row "$id" "$label" "$unit" "$scope" "$port")
            SERVICES_ROWS+=$'\n'
        done <<< "$CONFIG_SERVICES"
    fi
fi
SERVICES=$(jq -s '.' <<< "$SERVICES_ROWS")

# --- Assemble ------------------------------------------------------------------
jq -n \
  --arg mode "$MODE" \
  --arg profile "$PROFILE" --argjson mpp "$MPP" --argjson turbo "$TURBO" \
  --argjson batt "${BATT:-null}" --arg charge "$CS/$CE" --arg bstatus "$BSTATUS" --argjson ac "$AC" \
  --argjson ssh_active "$(port_active 22)" --arg ssh_exp "$(exposure_for_port 22)" \
  --argjson sun_active "$(port_active 47989)" --arg sun_exp "$(exposure_for_port 47989)" --argjson sun_inst "$SUN_INST" \
  --argjson ts_active "$TS_ACTIVE" --arg ts_ip4 "$TS_IP4" --arg ts_host "${TS_HOST:-?}" --argjson ts_peers "$TS_PEERS" \
  --argjson kdc_active "$(port_active 1716)" \
  --argjson rdp_inst "$RDP_INST" --argjson rdp_active "$RDP_ACTIVE" \
