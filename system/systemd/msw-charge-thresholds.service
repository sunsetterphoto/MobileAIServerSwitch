[Unit]
Description=Set battery charge thresholds according to the msw-mode state
After=multi-user.target
ConditionPathExistsGlob=/sys/class/power_supply/*/charge_control_end_threshold

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/msw-charge-apply

[Install]
WantedBy=multi-user.target
